# /etc/dim0/env — secrets + DB creds for the dim0 backend (AWS EC2 deploy).
#
# setup.sh copies this to /etc/dim0/env (chmod 600). Edit the copy with your
# real values. setup.sh also patches DIM0_WEBUI_DIST and PORT to match the
# install, so you usually only need to fill in the DB + AI sections below.
#
# All fields are env-overridable (backend/topix/config/config.py).

# ── Postgres (Neon) ───────────────────────────────────────────────────────
# From your Neon connection string: postgresql://USER:PW@HOST:5432/DB
POSTGRES_HOST=ep-xxxx.eu.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=dim0
# Neon requires SSL — the asyncpg pool enables it when the host is non-local.

# ── Qdrant (Qdrant Cloud) ─────────────────────────────────────────────────
QDRANT_HOST=xxxxxx-yyyy.aws.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_COLLECTION=topix
QDRANT_HTTPS=true
QDRANT_API_KEY=replace-me-qdrant-key

# ── Redis (Upstash) ───────────────────────────────────────────────────────
# Upstash requires TLS → keep REDIS_SSL=true.
REDIS_HOST=xxxxxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=replace-me-upstash-key
REDIS_DB=0
REDIS_SSL=true

# ── Auth + integration ───────────────────────────────────────────────────
# Generate: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-me-long-random-secret
# MUST match the TOKEN hardcoded in webui/public/launcher.html
# (currently b82baa54d8ff5b6e242d2894dbe83bc812e5a3bbae07a348aacdd7ba29200e6d).
# If you change it here, change launcher.html too (or research calls 401).
DIM0_INTEGRATION_TOKEN=b82baa54d8ff5b6e242d2894dbe83bc812e5a3bbae07a348aacdd7ba29200e6d

# ── AI: Ollama Cloud (ALL AI features — research + canvas chat) ───────────
# The claude CLI (deep research) reads ANTHROPIC_*; canvas chat reads
# OLLAMA_CHAT_BASE_URL + OLLAMA_API_KEY (OpenAI-compatible /v1/chat/completions).
ANTHROPIC_BASE_URL=https://ollama.com
ANTHROPIC_AUTH_TOKEN=replace-me-ollama-api-key
ANTHROPIC_MODEL=glm-5.2:cloud
OLLAMA_CHAT_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=replace-me-ollama-api-key
# Embedding is graceful (zero-vector fallback) — no OLLAMA_BASE_URL needed.

# ── Web evidence (Tavily) ────────────────────────────────────────────────
# Optional but recommended for grounded sources.
TAVILY_API_KEY=replace-me-tavily-key

# ── App (patched by setup.sh) ────────────────────────────────────────────
# Where the built webui dist lives; backend serves it (single-origin).
DIM0_WEBUI_DIST=/opt/dim0/webui/dist
# Backend listen port (nginx proxies here).
PORT=8080