# Replit Secrets template — copy these into Replit → Tools → Secrets.
# Values shown are PLACEHOLDERS; replace with your own from the 3 managed DBs.

# ── Postgres (Neon / Supabase) ────────────────────────────────────────────
# Create at https://neon.tech (free). From the connection string
# postgresql://USER:PW@HOST:5432/DB fill the fields below.
POSTGRES_HOST=ep-xxxx.eu.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=dim0
# Neon requires SSL — the asyncpg pool enables it when the host is non-local.

# ── Qdrant (Qdrant Cloud) ─────────────────────────────────────────────────
# Create at https://cloud.qdrant.io (free 1GB). Cluster → details.
QDRANT_HOST=xxxxxx-yyyy.aws.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_COLLECTION=topix
QDRANT_HTTPS=true
QDRANT_API_KEY=replace-me-qdrant-key

# ── Redis (Upstash) ───────────────────────────────────────────────────────
# Create at https://upstash.com (free serverless Redis). Use the endpoint host.
REDIS_HOST=xxxxxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=replace-me-upstash-key
REDIS_DB=0

# ── Auth + integration ────────────────────────────────────────────────────
# A long random string — generate with: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-me-long-random-secret
# The integration token the launcher uses to fire research. Any random hex.
DIM0_INTEGRATION_TOKEN=replace-me-integration-token

# ── Research agent: Claude CLI via Ollama cloud ───────────────────────────
# Same account/model used locally. The claude CLI subprocess reads these.
ANTHROPIC_BASE_URL=https://ollama.com
ANTHROPIC_AUTH_TOKEN=replace-me-ollama-api-key
ANTHROPIC_MODEL=glm-5.2:cloud

# ── Web evidence (Tavily) ──────────────────────────────────────────────────
# Optional but recommended for grounded sources. Create at https://tavily.com (free).
TAVILY_API_KEY=replace-me-tavily-key

# ── App ───────────────────────────────────────────────────────────────────
# Replit sets PORT automatically; do not override unless required.
API_PORT=8080